FROM node:lts-alpine AS frontend-build

RUN apk add --no-cache git
RUN git clone https://github.com/AVecsi/yivi-frontend-packages.git /frontend-src
WORKDIR /frontend-src
RUN npm install && npm run build
WORKDIR /frontend-src/examples/browser/yivi-frontend
RUN npm install

FROM golang:1 as build
# Crypto backend: zkdilithium (default, Rust) or lazer (C: liblazer+HEXL+GMP+MPFR).
# Switch with:  docker build -f Dockerfile.verify --build-arg BACKEND=lazer ...
ARG BACKEND=zkdilithium

# Set build environment
ENV CGO_ENABLED=1

RUN apt-get update && apt-get install -y gcc curl git make

# Backend-specific build toolchain.
RUN set -eux; \
    if [ "$BACKEND" = "lazer" ]; then \
        apt-get install -y --no-install-recommends \
            g++ cmake unzip patch libgmp-dev libmpfr-dev; \
    else \
        curl https://sh.rustup.rs -sSf | sh -s -- -y; \
    fi
ENV PATH="/root/.cargo/bin:${PATH}"

# Build irma CLI tool
COPY . /irmago
WORKDIR /irmago

# Build the selected backend's native dependency inside the module cache, then
# the irma binary. Module cache dirs are read-only, so chmod them first.
RUN set -eux; \
    go mod download; \
    if [ "$BACKEND" = "lazer" ]; then \
        LAZ="$(go list -m -f '{{.Dir}}' github.com/AVecsi/lazer)"; \
        chmod -R u+w "$LAZ"; \
        make -C "$LAZ"; \
        HEXL64="$LAZ/third_party/hexl-development/build/hexl/lib64/libhexl.a"; \
        [ -f "$HEXL64" ] || { mkdir -p "$(dirname "$HEXL64")"; \
            cp "$(find "$LAZ/third_party/hexl-development/build" -name libhexl.a | head -1)" "$HEXL64"; }; \
        go build -tags lazer -o /bin/irma ./irma; \
    else \
        PQG="$(go list -m -f '{{.Version}}' github.com/AVecsi/pq-gabi)"; \
        cd "/go/pkg/mod/github.com/!a!vecsi/pq-gabi@${PQG}"; \
        chmod -R u+w .; \
        make build; \
        cd /irmago; \
        go build -a -ldflags '-extldflags "-static -lm"' -o /bin/irma ./irma; \
    fi

# Create application user
RUN useradd -u 1000 -ms /bin/bash irma

# Use the build stage directly as the final image so all libraries are available
FROM build

# Copy built frontend
COPY --from=frontend-build /frontend-src /frontend

# Include schemes as assets in the Docker image to speed up the start-up time
RUN /bin/irma scheme download --use-schemes-assets-path

ENTRYPOINT ["/bin/irma"]